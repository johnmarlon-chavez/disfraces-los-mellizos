{
  "name": "disfraces-los-mellizos",
  "productName": "Disfraces Los Mellizos",
  "version": "0.1.0",
  "description": "Sistema de alquiler de disfraces - Disfraces Los Mellizos",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "dev": "node scripts/con-electron.mjs electron-vite dev",
    "build": "electron-vite build",
    "start": "node scripts/con-electron.mjs electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node scripts/con-electron.mjs --como-node node_modules/vitest/vitest.mjs run",
    "test:watch": "node scripts/con-electron.mjs --como-node node_modules/vitest/vitest.mjs",
    "test:e2e": "electron-vite build && playwright test",
    "seed": "electron-vite build && node scripts/con-electron.mjs electron out/main/seed.js",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "42.11.8",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "better-sqlite3": "12.11.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "7.18.4"
  }
}
